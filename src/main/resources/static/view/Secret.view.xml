<mvc:View
        controllerName="cicd.controller.Secret"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        displayBlock="true">

    <Page>

        <Table
                id="secretTable"
                items="{secrets>/items}">

            <columns>
                <Column width="30%"><Text text="Name"/></Column>
                <Column width="20%"><Text text="Type"/></Column>
                <Column width="25%"><Text text="Repository"/></Column>
                <Column width="25%" hAlign="End"><Text text="Actions"/></Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{secrets>name}"/>
                        <Text text="{secrets>type}"/>
                        <Text text="{secrets>repositoryUrl}"/>
                        <HBox justifyContent="End" alignItems="Center">
                            <Button
                                    text="Validate"
                                    icon="sap-icon://validate"
                                    press=".onValidateSecret"
                                    class="sapUiTinyMarginEnd"/>
                            <Button
                                    text="Delete"
                                    type="Transparent"
                                    icon="sap-icon://delete"
                                    press=".onDeleteSecret"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>

</mvc:View>