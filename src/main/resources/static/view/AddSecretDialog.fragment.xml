<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core"
        controllerName="cicd.controller.AddSecret">

    <Dialog
            id="addSecretDialog"
            title="Add Secret"
            contentWidth="400px">

        <content>
            <VBox class="sapUiSmallMargin sapUiSmallMarginTop">
                <Label text="Name" required="true"/>
                <Input
                        id="nameInput"
                        placeholder="e.g. GitHub Token"
                        width="100%"
                        class="sapUiSmallMarginBottom"/>

                <Label text="Type" required="true"/>
                <Select id="typeSelect" width="100%" class="sapUiSmallMarginBottom">
                    <items>
                        <core:Item key="TOKEN" text="Token"/>
                        <core:Item key="USERNAME_PASSWORD" text="Username and Password"/>
                        <core:Item key="SSH_KEY" text="SSH Key"/>
                    </items>
                </Select>

                <Label text="Value" required="true"/>
                <Input
                        id="valueInput"
                        placeholder="Enter secret value"
                        type="Password"
                        width="100%"/>
            </VBox>
        </content>

        <beginButton>
            <Button
                    text="Add"
                    type="Emphasized"
                    press=".onConfirmAddSecret"/>
        </beginButton>

        <endButton>
            <Button
                    text="Cancel"
                    press=".onCancelAddSecret"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>