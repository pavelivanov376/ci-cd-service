<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:core="sap.ui.core">

    <Dialog
            id="addRepositoryDialog"
            title="Add Repository"
            contentWidth="400px">

        <content>
            <VBox class="sapUiSmallMargin sapUiSmallMarginTop">
                <Label text="Repository URL" required="true"/>
                <Input
                        id="urlInput"
                        placeholder="https://github.com/org/repo"
                        width="100%"/>
            </VBox>
        </content>

        <beginButton>
            <Button
                    text="Add"
                    type="Emphasized"
                    press=".onConfirmAdd"/>
        </beginButton>

        <endButton>
            <Button
                    text="Cancel"
                    press=".onCancelAdd"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>