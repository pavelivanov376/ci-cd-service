<mvc:View
        controllerName="cicd.controller.Repository"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m">

    <Page title="Repositories">
        <headerContent>
            <Button
                    text="Add Repository"
                    type="Emphasized"
                    icon="sap-icon://add"
                    press=".onAddRepository"/>
        </headerContent>

        <Table id="repositoryTable" items="{repositories>/items}">
            <columns>
                <Column width="70%">
                    <Text text="URL"/>
                </Column>
                <Column width="30%" hAlign="End">
                    <Text text="Actions"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Link text="{repositories>url}"
                            href="{repositories>url}"
                            target="_blank"/>
                        <HBox justifyContent="End" alignItems="Center">
                            <Button
                                    text="Add Secret"
                                    type="Default"
                                    icon="sap-icon://add"
                                    press=".onAddSecret"/>
                            <Button
                                    text="Delete"
                                    type="Reject"
                                    icon="sap-icon://delete"
                                    press=".onDeleteRepository"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>

</mvc:View>