{
  "sap.app": {
    "id": "cicd",
    "type": "application",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "cicd.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "cicd.view",
        "controlId": "appPages",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "repositories",
          "pattern": "",
          "target": "repositories"
        }
      ],
      "targets": {
        "repositories": {
          "id": "repositories",
          "name": "Repository"
        }
      }
    }
  }
}